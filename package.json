{
  "name": "openwater-community-website",
  "version": "2.0.0",
  "description": "Openwater open-source community website with dynamic features and pathway-driven onboarding",
  "main": "js/main.js",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "build": "echo 'Static site - no build needed'",
